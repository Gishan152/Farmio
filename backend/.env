# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Instructions:
# 1. Get a Google Maps API key from Google Cloud Console:
#    - Go to https://console.cloud.google.com/
#    - Create a new project or select existing one
#    - Enable "Geocoding API" in the APIs & Services section
#    - Create credentials (API Key) for the Geocoding API
#    - Copy the API key and replace "your_google_maps_api_key_here" with it
#
# 2. Restart the warehouse-service after updating the API key:
#    docker compose -f docker-compose.dev.yml restart warehouse-service
#
# Note: Keep this file secure and never commit real API keys to version control!
