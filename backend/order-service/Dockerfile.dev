FROM eclipse-temurin:24-jdk-noble

WORKDIR /app

# For dev, we'll rely on bind mount of the entire backend directory into /app
# Ensure directory exists
RUN mkdir -p /app

# Expose port used by order-service in compose
EXPOSE 8086

# Fix Windows CRLF and executable bit on mvnw at container start, then run from order-service subdirectory
ENTRYPOINT ["/bin/sh", "-lc", "cd /app/order-service && if [ -f ./mvnw ]; then sed -i 's/\r$//' ./mvnw && chmod +x ./mvnw; fi; ./mvnw spring-boot:run"]