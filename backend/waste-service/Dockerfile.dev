FROM eclipse-temurin:24-jdk-noble

WORKDIR /app/waste-service

# Copy wrapper and .mvn so Maven can bootstrap
COPY waste-service/mvnw .
COPY waste-service/.mvn .mvn
RUN chmod +x mvnw

# Copy pom.xml so dependencies can be resolved
COPY waste-service/pom.xml .

# Default entrypoint: run Spring Boot via wrapper
ENTRYPOINT ["./mvnw", "spring-boot:run"]
