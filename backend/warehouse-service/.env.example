# Environment variables for Warehouse Service
# Copy this file to .env and add your actual values

# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Instructions to set up Google Maps API:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable the following APIs:
#    - Geocoding API
#    - Places API (optional, for enhanced location data)
# 4. Create credentials (API Key)
# 5. Restrict the API key to specific APIs for security
# 6. Replace 'your-google-maps-api-key-here' with your actual API key
